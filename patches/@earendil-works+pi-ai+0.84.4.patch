+    // invalid_prompt: Tool names must be unique。同名时以服务端工具为准。
+    const nativeNames = new Set(nativeTools.map((tool) => tool.type));
+    const immediateTools = nativeNames.size === 0
+        ? toolPlacement.immediate
+        : toolPlacement.immediate.filter((tool) => !nativeNames.has(tool.name));
+    if (immediateTools.length > 0 || nativeTools.length > 0) {
